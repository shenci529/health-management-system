{
  "name": "health-management-system",
  "version": "1.0.0",
  "description": "Health Management System",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "cd server && node server.js",
    "server:prod": "cd server && node server-prod.js",
    "db:init": "cd server && node database/init.js",
    "start": "npm run build && cd server && node database/init.js && node server-prod.js",
    "init": "npm install && cd server && npm install && npm run db:init"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "echarts": "^5.4.3",
    "element-ui": "^2.15.14",
    "vue": "^2.7.14",
    "vue-router": "^3.6.5"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "vite": "^4.5.0",
    "vite-plugin-vue2": "^2.0.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
