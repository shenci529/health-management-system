.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.section {
  padding: 30rpx;
}

.score-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  text-align: center;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #212121;
  display: block;
  margin-bottom: 30rpx;
}

.score-circle {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.score-ring {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
}

.score-inner {
  width: 100%;
  height: 100%;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.score-value {
  font-size: 72rpx;
  font-weight: bold;
  color: #212121;
}

.score-status {
  display: inline-block;
  padding: 12rpx 32rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.status-excellent {
  background: #e8f5e9;
  color: #4CAF50;
}

.status-good {
  background: #e3f2fd;
  color: #2196F3;
}

.status-normal {
  background: #fff8e1;
  color: #FF9800;
}

.status-warning {
  background: #ffebee;
  color: #f44336;
}

.card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #212121;
  display: block;
  margin-bottom: 24rpx;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.info-item {
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}

.info-label {
  font-size: 24rpx;
  color: #757575;
  display: block;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #212121;
  display: block;
}

.info-status {
  font-size: 22rpx;
  display: block;
  margin-top: 4rpx;
}

.text-blue { color: #2196F3; }
.text-green { color: #4CAF50; }
.text-yellow { color: #FF9800; }
.text-red { color: #f44336; }

.energy-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

.energy-item {
  text-align: center;
}

.energy-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}

.energy-circle.blue {
  background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
}

.energy-value {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
}

.energy-label {
  font-size: 24rpx;
  color: #757575;
}

.analysis-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.analysis-status {
  font-size: 30rpx;
  font-weight: 600;
  color: #212121;
}

.analysis-advice {
  font-size: 28rpx;
  color: #757575;
  line-height: 1.6;
}

.risk-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.risk-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #f44336;
  display: block;
  margin-bottom: 8rpx;
}

.risk-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #f44336;
}

.risk-icon {
  font-size: 28rpx;
}

.vision-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.vision-icon {
  width: 120rpx;
  height: 120rpx;
  background: #f3e5f5;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}

.vision-info {
  flex: 1;
}

.vision-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #212121;
  display: block;
}

.vision-level {
  font-size: 28rpx;
  color: #9c27b0;
  font-weight: 600;
}

.vision-advice {
  font-size: 28rpx;
  color: #757575;
  line-height: 1.6;
}

.indicator-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.indicator-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.indicator-item:last-child {
  border-bottom: none;
}

.indicator-label {
  font-size: 28rpx;
  color: #757575;
}

.indicator-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #212121;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.check-icon {
  color: #4CAF50;
  font-size: 32rpx;
  font-weight: bold;
}

.advice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.advice-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.advice-number {
  width: 48rpx;
  height: 48rpx;
  background: #2196F3;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.advice-item text {
  font-size: 28rpx;
  color: #757575;
  line-height: 1.6;
}
