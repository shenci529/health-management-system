.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.section {
  padding: 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #212121;
  display: block;
  margin-bottom: 30rpx;
}

.form-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  font-size: 28rpx;
  color: #424242;
  display: block;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  background: #4CAF50;
  color: white;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 20rpx;
  border: none;
}

.submit-btn:active {
  background: #45a049;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.record-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #212121;
}

.record-date {
  font-size: 26rpx;
  color: #9e9e9e;
}

.record-detail {
  display: flex;
  gap: 30rpx;
}

.record-detail text {
  font-size: 26rpx;
  color: #757575;
}
