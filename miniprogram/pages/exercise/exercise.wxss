.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.section {
  padding: 30rpx;
}

.category-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.category-icon {
  font-size: 48rpx;
}

.category-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #212121;
}

.exercise-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.exercise-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.exercise-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.exercise-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #212121;
}

.exercise-duration {
  font-size: 26rpx;
  color: #9e9e9e;
}

.exercise-desc {
  font-size: 28rpx;
  color: #757575;
  line-height: 1.6;
  display: block;
  margin-bottom: 20rpx;
}

.exercise-benefits {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.benefit-tag {
  background: #e8f5e9;
  color: #4CAF50;
  padding: 8rpx 16rpx;
  border-radius: 50rpx;
  font-size: 24rpx;
}

.exercise-frequency {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
}

.exercise-frequency text {
  font-size: 26rpx;
  color: #9e9e9e;
}
