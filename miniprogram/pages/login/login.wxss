.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #81C784 0%, #4CAF50 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.login-card {
  background: white;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  width: 100%;
  max-width: 600rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #212121;
  display: block;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #757575;
}

.error-message {
  background: #ffebee;
  color: #c62828;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
  text-align: center;
  font-size: 28rpx;
}

.input-group {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #424242;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  border: 2rpx solid transparent;
}

.input-wrapper:focus-within {
  border-color: #4CAF50;
  background: white;
}

.icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  opacity: 0.6;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #212121;
}

.login-btn {
  width: 100%;
  background: #4CAF50;
  color: white;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 40rpx;
  border: none;
}

.login-btn:active {
  background: #45a049;
}

.hint {
  margin-top: 60rpx;
  text-align: center;
}

.hint text {
  display: block;
  font-size: 26rpx;
  color: #9e9e9e;
  margin-bottom: 8rpx;
}
