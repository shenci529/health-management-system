<view class="container">
  <!-- 头部 -->
  <view class="header">
    <view class="header-content">
      <view>
        <text class="greeting">你好，{{userName}}！</text>
        <text class="sub-greeting">今天也要保持健康哦～</text>
      </view>
      <view class="avatar">{{userInitial}}</view>
    </view>
  </view>

  <!-- 快捷添加按钮 -->
  <view class="quick-add">
    <view class="add-btn" bindtap="goToRecord">
      <view class="add-icon">+</view>
      <text>添加健康记录</text>
    </view>
  </view>

  <!-- 健康数据卡片 -->
  <view class="section">
    <text class="section-title">健康数据</text>
    <view class="health-grid">
      <view class="health-card">
        <view class="card-icon blue">
          <text>📏</text>
        </view>
        <text class="card-label">身高</text>
        <text class="card-value">{{latestRecord.height || '--'}} cm</text>
      </view>

      <view class="health-card">
        <view class="card-icon green">
          <text>⚖️</text>
        </view>
        <text class="card-label">体重</text>
        <text class="card-value">{{latestRecord.weight || '--'}} kg</text>
      </view>

      <view class="health-card">
        <view class="card-icon yellow">
          <text>📊</text>
        </view>
        <text class="card-label">BMI</text>
        <text class="card-value">{{bmi || '--'}}</text>
        <text class="card-status {{bmiStatusColor}}">{{bmiStatus}}</text>
      </view>

      <view class="health-card">
        <view class="card-icon red">
          <text>❤️</text>
        </view>
        <text class="card-label">心率</text>
        <text class="card-value">{{latestRecord.heartRate || '--'}} 次/分</text>
      </view>

      <view class="health-card">
        <view class="card-icon purple">
          <text>👁️</text>
        </view>
        <text class="card-label">视力</text>
        <text class="card-value">{{latestRecord.vision || '--'}}</text>
      </view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="section">
    <text class="section-title">更多功能</text>
    <view class="quick-grid">
      <view class="quick-item" bindtap="goToAssessment">
        <view class="quick-icon primary">
          <text>📈</text>
        </view>
        <text>健康评估</text>
      </view>
      <view class="quick-item" bindtap="goToKnowledge">
        <view class="quick-icon blue">
          <text>📚</text>
        </view>
        <text>健康知识</text>
      </view>
    </view>
  </view>
</view>
