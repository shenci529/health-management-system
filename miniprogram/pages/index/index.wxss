.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  padding: 40rpx 30rpx 120rpx;
  color: white;
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.greeting {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.sub-greeting {
  font-size: 28rpx;
  opacity: 0.9;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
}

.quick-add {
  padding: 0 30rpx;
  margin-top: -60rpx;
}

.add-btn {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.add-icon {
  width: 80rpx;
  height: 80rpx;
  background: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 48rpx;
  font-weight: bold;
}

.add-btn text {
  font-size: 32rpx;
  font-weight: 600;
  color: #424242;
}

.section {
  padding: 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #212121;
  display: block;
  margin-bottom: 30rpx;
}

.health-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.health-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 16rpx;
}

.card-icon.blue {
  background: #e3f2fd;
}

.card-icon.green {
  background: #e8f5e9;
}

.card-icon.yellow {
  background: #fff8e1;
}

.card-icon.red {
  background: #ffebee;
}

.card-icon.purple {
  background: #f3e5f5;
}

.card-label {
  font-size: 26rpx;
  color: #757575;
  display: block;
  margin-bottom: 8rpx;
}

.card-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #212121;
  display: block;
}

.card-status {
  font-size: 24rpx;
  margin-top: 4rpx;
  display: block;
}

.text-blue {
  color: #2196F3;
}

.text-green {
  color: #4CAF50;
}

.text-yellow {
  color: #FF9800;
}

.text-red {
  color: #f44336;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.quick-item {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.quick-icon.primary {
  background: #4CAF50;
}

.quick-icon.blue {
  background: #2196F3;
}

.quick-item text {
  font-size: 30rpx;
  font-weight: 600;
  color: #424242;
}
