<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="header-title">健康日志</text>
    <view class="add-btn" bindtap="openModal">
      <text>十</text>
    </view>
  </view>

  <!-- 日志列表 -->
  <view class="section" wx:if="{{groupedLogs.length > 0}}">
    <view wx:for="{{groupedLogs}}" wx:key="date" class="log-group">
      <view class="group-header">
        <text class="group-icon">📅</text>
        <text class="group-date">{{item.date}}</text>
      </view>
      
      <view class="log-list">
        <view wx:for="{{item.logs}}" wx:key="id" class="log-item">
          <view class="log-icon {{item.logType}}">
            <text>{{item.logIcon}}</text>
          </view>
          <view class="log-content">
            <view class="log-meta">
              <text class="log-type {{item.logType}}">{{item.logLabel}}</text>
              <text class="log-time">{{item.logTime}}</text>
            </view>
            <text class="log-text">{{item.content}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{groupedLogs.length === 0}}" class="empty-state">
    <text class="empty-icon">💗</text>
    <text class="empty-text">还没有健康日志</text>
    <text class="empty-hint">点击右上角的 + 开始记录</text>
  </view>

  <!-- 添加日志弹窗 -->
  <view wx:if="{{isModalOpen}}" class="modal-overlay" catchtap="closeModal">
    <view class="modal-content" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">添加日志</text>
        <view class="modal-close" bindtap="closeModal">
          <text>✕</text>
        </view>
      </view>
      
      <view class="type-selector">
        <view 
          wx:for="{{types}}" 
          wx:key="key" 
          wx:for-item="type"
          class="type-btn {{newLog.type === type.key ? 'active' : ''}}"
          bindtap="selectType"
          data-type="{{type.key}}"
        >
          <text class="type-icon">{{type.icon}}</text>
          <text class="type-label">{{type.label}}</text>
        </view>
      </view>
      
      <view class="textarea-wrapper">
        <textarea 
          class="textarea" 
          placeholder="记录今天的健康情况..." 
          bindinput="onContentInput"
          value="{{newLog.content}}"
        />
      </view>
      
      <button class="submit-btn" bindtap="onSubmit" disabled="{{!newLog.content.trim()}}">保存</button>
    </view>
  </view>
</view>
