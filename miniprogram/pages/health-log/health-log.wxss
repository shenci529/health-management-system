.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  background: white;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #212121;
}

.add-btn {
  width: 72rpx;
  height: 72rpx;
  background: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn text {
  font-size: 36rpx;
  color: white;
  font-weight: bold;
}

.section {
  padding: 30rpx;
}

.log-group {
  margin-bottom: 40rpx;
}

.group-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.group-icon {
  font-size: 32rpx;
}

.group-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #757575;
}

.log-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.log-item {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.log-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.log-icon.blue {
  background: #e3f2fd;
}

.log-icon.green {
  background: #e8f5e9;
}

.log-icon.purple {
  background: #f3e5f5;
}

.log-icon.gray {
  background: #f5f5f5;
}

.log-content {
  flex: 1;
}

.log-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.log-type {
  font-size: 24rpx;
  font-weight: 600;
}

.log-type.blue {
  color: #2196F3;
}

.log-type.green {
  color: #4CAF50;
}

.log-type.purple {
  color: #9c27b0;
}

.log-type.gray {
  color: #757575;
}

.log-time {
  font-size: 24rpx;
  color: #bdbdbd;
}

.log-text {
  font-size: 28rpx;
  color: #424242;
  line-height: 1.5;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #757575;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #bdbdbd;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  width: 100%;
  max-width: 750rpx;
  background: white;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #212121;
}

.modal-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close text {
  font-size: 32rpx;
  color: #757575;
}

.type-selector {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.type-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
}

.type-btn.active {
  background: #4CAF50;
}

.type-icon {
  font-size: 48rpx;
}

.type-label {
  font-size: 24rpx;
  color: #757575;
}

.type-btn.active .type-label {
  color: white;
}

.textarea-wrapper {
  margin-bottom: 30rpx;
}

.textarea {
  width: 100%;
  height: 200rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  background: #4CAF50;
  color: white;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.submit-btn[disabled] {
  background: #e0e0e0;
  color: #9e9e9e;
}
