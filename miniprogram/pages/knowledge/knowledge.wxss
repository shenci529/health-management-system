.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.section {
  padding: 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #212121;
  display: block;
  margin-bottom: 30rpx;
}

.knowledge-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.knowledge-item {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
}

.knowledge-icon {
  font-size: 60rpx;
  flex-shrink: 0;
}

.knowledge-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.knowledge-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #212121;
}

.knowledge-desc {
  font-size: 26rpx;
  color: #757575;
  line-height: 1.6;
}
